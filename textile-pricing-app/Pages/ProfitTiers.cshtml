@page
@model ProfitTiersModel
@{
    ViewData["Title"] = "دسته‌های سود";
}

<section class="page-heading">
    <div>
        <h1>دسته‌های سود</h1>
    </div>
    <a class="btn btn-outline-dark" asp-page="/Index">بازگشت به آنالیز</a>
</section>

<section class="crud-layout profit-tiers-layout materials-layout">
    <aside class="side-panel base-info-side-panel">
        <h2 class="panel-title">@Model.FormTitle</h2>
        <a class="btn btn-outline-dark w-100 mb-3" asp-page="/ProfitTiers">جدید</a>
        <form method="post" asp-page-handler="Save" class="stack">
            <input type="hidden" asp-for="Input.Id" />

            <label asp-for="Input.CategoryName">نام دسته</label>
            <input asp-for="Input.CategoryName" class="form-control" />
            <span asp-validation-for="Input.CategoryName" class="text-danger"></span>
            <small class="field-hint">نام دسته یک شناسه مستقل است و می‌تواند عددی یا متنی باشد.</small>

            <label asp-for="Input.Percent">درصد سود</label>
            <input asp-for="Input.Percent" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Input.Percent" class="text-danger"></span>

            <button type="submit" class="btn btn-dark">ذخیره (F3)</button>
            @if (Model.Input.Id > 0)
            {
                <a class="btn btn-outline-secondary" asp-page="/ProfitTiers">انصراف</a>
            }
        </form>
    </aside>

    <main class="report-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="table-responsive material-table-wrap">
            <table class="table align-middle pricing-table compact-table">
                <thead>
                    <tr>
                        <th>نام دسته</th>
                        <th>درصد سود</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.CategoryName</td>
                            <td>@Number(item.Percent)٪</td>
                            <td class="row-actions">
                                <a class="btn btn-sm btn-outline-dark" asp-page="/ProfitTiers" asp-route-EditId="@item.Id">ویرایش</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('این دسته سود حذف شود؟')">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</section>

@functions {
    private static string Number(decimal value) => string.Format("{0:N2}", value).TrimEnd('0').TrimEnd('.');
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

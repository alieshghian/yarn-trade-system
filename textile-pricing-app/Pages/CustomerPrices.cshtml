@page
@model CustomerPricesModel
@{
    ViewData["Title"] = "قیمت مشتریان";
}

<section class="page-heading no-print">
    <div>
        <h1>قیمت مشتریان</h1>
    </div>
</section>

<section class="crud-layout customer-prices-layout no-print">
    <aside class="side-panel settings-panel factory-price-side-panel">
        <h2 class="panel-title">فیلتر</h2>
        <form method="get" class="toolbar-form product-search factory-filter-form" data-live-search-form>
            <input id="Query" name="Query" value="@Model.Query" class="form-control" placeholder="جست‌وجوی کد، نام یا گروه محصول..." autocomplete="off" data-live-search-input />

            <select name="CustomerId" id="CustomerId" class="form-select" data-live-search-submit-on-change>
                <option value="" selected="@(Model.CustomerId is null)">همه مشتریان</option>
                @foreach (var customer in Model.Customers)
                {
                    <option value="@customer.Id" selected="@(customer.Id == Model.CustomerId)">@customer.Name</option>
                }
            </select>

            <select id="StatusFilter" name="StatusFilter" class="form-select" data-live-search-submit-on-change>
                <option value="all" selected="@(Model.StatusFilter == "all")">همه وضعیت‌ها</option>
                <option value="loss" selected="@(Model.StatusFilter == "loss")">زیان نقدی</option>
                <option value="equal" selected="@(Model.StatusFilter == "equal")">بدون سود و زیان نقدی</option>
                <option value="profit" selected="@(Model.StatusFilter == "profit")">سود نقدی</option>
            </select>

            <select id="SortBy" name="SortBy" class="form-select" data-live-search-submit-on-change>
                <option value="default" selected="@(Model.SortBy == "default")">مرتب‌سازی پیش‌فرض</option>
                <option value="base-profit" selected="@(Model.SortBy == "base-profit")">سود تعیین‌شده</option>
                <option value="target-profit" selected="@(Model.SortBy == "target-profit")">سود مطلوب</option>
                <option value="credit-profit" selected="@(Model.SortBy == "credit-profit")">سود اعتباری</option>
                <option value="profit-gap" selected="@(Model.SortBy == "profit-gap")">فاصله تا سود مطلوب</option>
            </select>

            <select id="SortDirection" name="SortDirection" class="form-select" data-live-search-submit-on-change>
                <option value="desc" selected="@(Model.SortDirection == "desc")">زیاد به کم</option>
                <option value="asc" selected="@(Model.SortDirection == "asc")">کم به زیاد</option>
            </select>

        </form>

        <div class="summary-grid settings-summary customer-rate-summary">
            <div>
                <span>تخفیف‌های فعال</span>
                <strong>@Model.Rows.Count(row => row.HasDiscount)</strong>
                <small>محصول</small>
            </div>
        </div>

    </aside>

    <main class="report-panel factory-price-panel">
        <div class="customer-side-actions customer-report-actions no-print">
            <form method="post" asp-page-handler="CreateSnapshot" class="inline-form">
                <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                <input type="hidden" name="Query" value="@Model.Query" />
                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                <input type="hidden" name="SortBy" value="@Model.SortBy" />
                <input type="hidden" name="SortDirection" value="@Model.SortDirection" />
                <button class="btn btn-dark" type="submit">ثبت اسنپ‌شات PDF</button>
            </form>
            <button class="btn btn-outline-dark" type="button" onclick="window.print()">چاپ</button>
        </div>

        <div class="factory-price-list">
            @foreach (var row in Model.Rows)
            {
                <article class="factory-price-row customer-price-row @row.StatusCssClass">
                    <div class="factory-price-row__product">
                        <div class="product-row-media">
                            @if (!string.IsNullOrWhiteSpace(row.ImagePath))
                            {
                                <img src="@row.ImagePath" alt="@ProductTitle(row)" />
                            }
                            else
                            {
                                <img src="/images/no-picture.svg" alt="No Picture" />
                            }
                        </div>
                        <div class="product-row-copy">
                            <strong>@row.ProductCode</strong>
                            @if (!string.IsNullOrWhiteSpace(row.ProductName))
                            {
                                <span>@row.ProductName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.ProductGroupName))
                            {
                                <small>@row.ProductGroupName</small>
                            }
                            <span>اعتباری @Number(row.CreditDiscountPercent)٪ | نقدی @Number(row.CashDiscountPercent)٪</span>
                        </div>
                        @if (row.IsVatExempt)
                        {
                            <span>بدون ارزش افزوده</span>
                        }
                    </div>

                    <div class="factory-price-status" title="وضعیت قیمت نقدی نسبت به قیمت تمام‌شده">
                        <em>@row.StatusText</em>
                        <small class="@row.TargetProfitCssClass">سود تعیین شده @SignedPercent(row.TargetProfitPercent)</small>
                    </div>

                    <div class="factory-price-metric" title="جمع مواد و خدمات + کسری و ضایعات">
                        <span>قیمت تمام‌شده</span>
                        <strong>@Money(row.CostBasePrice)</strong>
                    </div>

                    <div class="factory-price-metric" title="@row.CashPriceDescription">
                        <span>فروش نقدی</span>
                        <strong class="price-with-percent">@Money(row.CustomerCashPrice) <small class="factory-profit-inline @row.CashProfitCssClass">(@SignedPercent(row.CashProfitPercent))</small></strong>
                    </div>

                    <div class="factory-price-metric factory-price-metric--primary" title="فروش اعتباری بعد از تخفیف اعتباری @Number(row.CreditDiscountPercent)٪ | فروش کارخانه: @Money(row.FactoryPrice)">
                        <span>فروش اعتباری</span>
                        <strong class="price-with-percent">@Money(row.CustomerPrice) <small class="factory-profit-inline @row.CreditProfitCssClass">(@SignedPercent(row.CreditProfitPercent))</small></strong>
                    </div>

                    <div class="factory-price-row__print">
                        <a class="btn btn-sm btn-outline-dark" asp-page="/CustomerPrint" asp-route-CustomerId="@row.CustomerId" asp-route-ProductCode="@row.ProductCode" asp-route-RowCashDiscountPercent="@Invariant(row.CashDiscountPercent)" asp-route-RowCreditDiscountPercent="@Invariant(row.CreditDiscountPercent)" target="_blank">چاپ</a>
                    </div>
                </article>
            }
        </div>
    </main>
</section>

<section class="customer-prices-print print-only" dir="rtl">
    <table class="print-table customer-prices-print__table">
        <thead>
            <tr class="customer-prices-print__heading-row">
                <th colspan="4">
                    <header class="customer-prices-print__header">
                        <div>
                            <h1>قیمت مشتریان</h1>
                            <p>مشتری: @Model.ReportCustomerName</p>
                        </div>
                        <div>
                            <span>تاریخ: @Model.ReportDateText</span>
                            <span>تعداد ردیف: @Model.Rows.Count</span>
                        </div>
                    </header>
                </th>
            </tr>
            <tr>
                <th>ردیف</th>
                <th>عنوان محصول</th>
                <th>فروش نقدی</th>
                <th>فروش اعتباری</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="4">ردیفی برای چاپ وجود ندارد.</td>
                </tr>
            }
            else
            {
                @for (var index = 0; index < Model.Rows.Count; index++)
                {
                    var row = Model.Rows[index];
                    <tr>
                        <td>@(index + 1)</td>
                        <td>@row.ProductCode</td>
                        <td>@Money(row.CustomerCashPrice)</td>
                        <td>@Money(row.CustomerPrice)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

@functions {
    private static string Money(decimal value) => string.Format("{0:N0}", value);
    private static string Number(decimal value) => string.Format("{0:N2}", value).TrimEnd('0').TrimEnd('.');
    private static string Invariant(decimal value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string ProductTitle(TextilePricingApp.Models.CustomerPriceRow row) =>
        string.IsNullOrWhiteSpace(row.ProductName) ? row.ProductCode : $"{row.ProductCode} - {row.ProductName}";

    private static string SignedPercent(decimal value)
    {
        var text = Math.Abs(value).ToString("N1", System.Globalization.CultureInfo.InvariantCulture);
        return value < 0 ? $"\u200E-{text}٪\u200E" : $"\u200E{text}٪\u200E";
    }
}

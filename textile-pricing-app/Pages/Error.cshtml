@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="error-page">
    <div class="error-card">
        <div class="error-code">@Model.HttpStatusCode</div>
        <h1>@Model.Title</h1>
        <p>@Model.Message</p>
        @if (!string.IsNullOrWhiteSpace(Model.Hint))
        {
            <div class="error-hint">@Model.Hint</div>
        }

        @if (Model.ShowRequestId)
        {
            <div class="error-trace">
                کد پیگیری:
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a class="btn btn-dark" asp-page="/Home">صفحه خانه</a>
            @if (Model.CanGoBack)
            {
                <button class="btn btn-outline-dark" type="button" onclick="history.back()">بازگشت</button>
            }
        </div>
    </div>
</section>

@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "تغییر رمز";
}

<section class="page-heading">
    <div>
        <h1>تغییر رمز</h1>
    </div>
</section>

<section class="report-panel auth-form-panel">
    @if (Model.Saved)
    {
        <div class="alert alert-success">رمز عبور تغییر کرد.</div>
    }

    <form method="post" class="stack compact-auth-form">
        <label asp-for="CurrentPassword">رمز فعلی</label>
        <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="text-danger"></span>

        <label asp-for="NewPassword">رمز جدید</label>
        <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>

        <label asp-for="ConfirmPassword">تکرار رمز جدید</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

        <button class="btn btn-dark" type="submit">ثبت رمز جدید (F3)</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

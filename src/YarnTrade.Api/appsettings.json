{
  "Database": {
    "AutoMigrate": false
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "Origins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "",
  "Attachments": {
    "RequireMalwareScan": false
  },
  "Security": {
    "AccessTokenMinutes": 60,
    "RefreshTokenHours": 24,
    "CookieMinutes": 60,
    "LockoutMinutes": 10,
    "MaxFailedAccessAttempts": 5,
    "PublicAppOrigin": "",
    "InvitationHours": 24,
    "PasswordResetHours": 1,
    "TrustedBrowserDays": 30,
    "OtpMinutes": 10,
    "OtpMaxAttempts": 5,
    "OtpMaxSends": 5,
    "OtpResendSeconds": 60,
    "DevelopmentAutoLogin": {
      "Enabled": false,
      "UserEmail": "admin@yarntrade.local"
    },
    "ReverseProxy": {
      "Enabled": false,
      "ForwardLimit": 1,
      "KnownProxies": []
    },
    "Authentication": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Uploads": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Reports": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Backups": { "PermitLimit": 2, "WindowSeconds": 300 }
  },
  "AuthenticationEmail": {
    "Host": "",
    "Port": 587,
    "FromAddress": "",
    "UserName": "",
    "Password": "",
    "EnableSsl": true
  }
}

{
  "name": "yarn-trade-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:form-designer": "node --test src/components/base-form/formSchemaPresentation.test.mjs src/components/base-form/laboratoryFormDraftState.test.mjs src/components/base-form/formDocumentStructure.test.mjs src/components/base-form/formSchemaPresentation.behavior.test.mjs src/components/base-form/formDocumentRecovery.test.mjs src/components/base-form/formCatalogAndTheme.test.mjs src/components/base-form/headerDesignerRegression.test.mjs src/components/base-form/componentBehavior.test.mjs src/components/base-form/formBehavior.test.mjs src/components/base-form/appearanceCommands.test.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "package:color-sampler": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/Publish-ColorSamplerDownloads.ps1",
    "build:release": "npm run package:color-sampler && npm run build",
    "preview": "vite preview",
    "test:form-designer:browser": "node tests/form-designer.browser.mjs && node tests/form-runtime.browser.mjs",
    "validate:form-designer": "npm run test:form-designer && node --test src/components/base-form/designerSession.test.mjs src/components/base-form/formLaboratoryDesigner.test.mjs && tsc --noEmit -p tsconfig.app.json && npm run test:form-designer:browser"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
